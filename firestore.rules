rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){ return request.auth != null; }
  function me(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
  function approved(){ return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().status == 'approved'; }
  function admin(){ return approved() && me().role == 'admin'; }
  function editor(){ return approved() && me().role in ['admin','editor']; }
  match /users/{uid} {
   allow create: if signedIn() && request.auth.uid == uid && request.resource.data.email == request.auth.token.email && request.resource.data.role == 'pending' && request.resource.data.status == 'pending';
   allow read: if signedIn() && (request.auth.uid == uid || admin());
   allow update, delete: if admin();
  }
  match /{collection}/{id} {
   allow read: if approved() && collection in ['systems','repairs','contractors','evaluations'];
   allow create, update, delete: if editor() && collection in ['systems','repairs','contractors','evaluations'];
  }
 }
}